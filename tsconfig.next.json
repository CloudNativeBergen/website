{
  // Type-check project for `next build` only (#1960). .vercelignore drops
  // api/, services/, packages/, tests and docs, so files that import them
  // (scripts, tests, stories) are left out here. `pnpm run typecheck` still
  // runs tsc over the full tsconfig.json, which covers all of them.
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "e2e",
    "playwright.config.ts",
    "api",
    "packages",
    "services",
    "scripts/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/__tests__/**",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "**/docs/**",
    ".storybook/**",
    "vitest.setup.ts"
  ]
}
