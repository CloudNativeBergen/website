    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^19.2.6",
    "react-dropzone": "^20.1.1",
    "resend": "^6.26.0",
    "sanity": "^6.12.0",
    "server-only": "^0.0.1",
    "signature_pad": "^5.1.4",
    "speakingurl": "^14.0.1",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tldts": "^7.4.11",
    "typescript": "^6.0.3",
    "uuid": "^14.0.2",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@qodo/command": "^0.36.0",
    "@sanity/client": "^8.5.0",
    "@sanity/migrate": "^8.0.2",
    "@sanity/vision": "^6.12.0",
    "@starefossen/sanity-plugin-inline-svg-input": "^1.3.7",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@storybook/test-runner": "^0.24.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.5.4",
    "chromatic": "^18.7.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "groq-js": "2.0.0",
    "http-server": "^14.1.1",
    "knip": "~6.34.0",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "simple-git-hooks": "^2.14.0",
    "storybook": "^10.6.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run check && pnpm run test"
  }
}
