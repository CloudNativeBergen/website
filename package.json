{
  "name": "cloud-native-bergen",
  "version": "2025.10.30",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/stamp-sw.mjs && next build",
    "build:clean": "rm -rf .next && pnpm run build",
    "start": "next start",
    "check": "concurrently -n typecheck,lint,tenancy,knip,format -c blue,green,cyan,yellow,magenta --kill-others-on-fail \"pnpm run typecheck\" \"pnpm run lint\" \"pnpm run lint:tenancy\" \"pnpm run knip\" \"pnpm run format:check\"",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "lint:tenancy": "node eslint-rules/tenancy-ratchet.js",
    "lint:tenancy:update": "node eslint-rules/tenancy-ratchet.js --update",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:debug": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:badges": "vitest run __tests__/lib/badge/",
    "format:check": "prettier --cache --check .",
    "format": "prettier --cache --write --list-different .",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-storybook:test": "storybook build --test",
    "storybook:test": "test-storybook --maxWorkers=50%",
    "storybook:test-ci": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"pnpm build-storybook:test --quiet && npx http-server storybook-static --port 6006 --silent\" \"wait-on tcp:127.0.0.1:6006 && pnpm storybook:test\"",
    "qodo": "qodo",
    "qodo:chat": "qodo chat",
    "qodo:review": "qodo merge",
    "sanity": "sanity",
    "manage-orphaned-files": "tsx scripts/manage-orphaned-files.ts",
    "analyze-code": "tsx scripts/analyze-code-lines.ts",
    "generate-badge-ed25519-key": "tsx scripts/generate-badge-ed25519-key.ts",
    "audit-sponsor-health": "tsx scripts/audit-sponsor-health.ts",
    "erase-speaker": "tsx scripts/erase-speaker.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "shoot": "node scripts/shoot-story.mjs"
  },
  "browserslist": "defaults, not ie <= 11",
  "dependencies": {
    "@digitalbazaar/data-integrity": "^2.5.0",
    "@digitalbazaar/ed25519-multikey": "^1.3.1",
    "@digitalbazaar/eddsa-rdfc-2022-cryptosuite": "^1.3.0",
    "@digitalbazaar/security-document-loader": "^3.2.0",
