{
  "compilerOptions": {
    "target": "ES2017",
    "types": ["vitest/globals"],
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    // Named explicitly because `**` does not descend into dot-directories.
    // Without these the Storybook mocks are never type-checked, and the
    // `satisfies typeof import(...)` parity guards they carry — the whole
    // reason a stub is a typed file rather than a plain object — silently
    // assert nothing.
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "e2e", "playwright.config.ts"]
}
