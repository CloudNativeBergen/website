{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // Domain code is imported from the website's src/lib, never copied.
    // Wrangler's esbuild and the root vitest config both honour this alias.
    "paths": { "@/*": ["../src/*"] }
  },
  "include": ["src/**/*.ts"]
}
