{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "konf-api",
  "account_id": "eefa2cb5c8528a07d7bf8b00a6606dcd",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // supergraph.graphql (pnpm compose) is bundled as a string.
  "rules": [{ "type": "Text", "globs": ["**/*.graphql"], "fallthrough": true }],
  // Bindings do not inherit into envs, so each env lists its own.
  // Secrets per env: declared in secrets.json (mise run secrets:sync).
  // OVERRIDE_TENANTS: @override label -> orgIds routed to the native subgraph.
  // Transition only (#1925): prefer the d1_override flag in tenant-directory D1.
  // API_LIMITER: per caller, 300 requests a minute (#1790);
  // API_MUTATION_LIMITER: per caller, 60 mutations a minute (#1888);
  // API_IP_LIMITER: per IP, 1200 a minute, before the tenant lookup. namespace_id is
  // unique per account; the local default shares preview's.
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1791",
      "simple": { "limit": 300, "period": 60 },
    },
    {
      "name": "API_MUTATION_LIMITER",
      "namespace_id": "1888",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "API_IP_LIMITER",
      "namespace_id": "1795",
      "simple": { "limit": 1200, "period": 60 },
    },
  ],
  "vars": {
    "IDENTITY_ISSUER": "https://id-preview.konf.app",
    "OVERRIDE_TENANTS": {
      "conference-settings": ["organization-cloud-native-days", "kkdemo.org"],
    },
  },
  "services": [
    { "binding": "DIRECTORY", "service": "konf-tenant-directory" },
    { "binding": "CONTENT", "service": "konf-content" },
    { "binding": "PROGRAM", "service": "konf-program" },
    { "binding": "SPONSORS", "service": "konf-sponsors" },
    { "binding": "CONFERENCE", "service": "konf-conference" },
    { "binding": "IDENTITY", "service": "konf-identity" },
    {
      "binding": "IDENTITY_GRAPH",
      "service": "konf-identity",
      "entrypoint": "Graph",
    },
    {
      "binding": "MEMBERSHIP",
      "service": "konf-identity",
      "entrypoint": "Membership",
    },
  ],
  "env": {
    "preview": {
      "name": "konf-api-preview",
      "workers_dev": true,
      // Placeholder until identity's preview host exists.
      "vars": {
        "IDENTITY_ISSUER": "https://id-preview.konf.app",
        "OVERRIDE_TENANTS": {
          "conference-settings": [
            "organization-cloud-native-days",
            "kkdemo.org",
          ],
        },
      },
      "ratelimits": [
        {
          "name": "API_LIMITER",
          "namespace_id": "1791",
          "simple": { "limit": 300, "period": 60 },
        },
        {
          "name": "API_MUTATION_LIMITER",
          "namespace_id": "1888",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "API_IP_LIMITER",
          "namespace_id": "1795",
          "simple": { "limit": 1200, "period": 60 },
        },
      ],
      // Security requirement 8: preview never binds production services.
      "services": [
        { "binding": "DIRECTORY", "service": "konf-tenant-directory-preview" },
        { "binding": "CONTENT", "service": "konf-content-preview" },
        { "binding": "PROGRAM", "service": "konf-program-preview" },
        { "binding": "SPONSORS", "service": "konf-sponsors-preview" },
        { "binding": "CONFERENCE", "service": "konf-conference-preview" },
        { "binding": "IDENTITY", "service": "konf-identity-preview" },
        {
          "binding": "IDENTITY_GRAPH",
          "service": "konf-identity-preview",
          "entrypoint": "Graph",
        },
        {
          "binding": "MEMBERSHIP",
          "service": "konf-identity-preview",
          "entrypoint": "Membership",
        },
      ],
    },
    "production": {
      "name": "konf-api",
      "routes": [{ "pattern": "api.konf.app", "custom_domain": true }],
      // Identity has its own host: auth.konf.app is the NextAuth site today.
      "vars": {
        "IDENTITY_ISSUER": "https://id.konf.app",
        // Operator lane (#1892 phase 4): kontroll. Preview leaves it unset.
        "OPERATOR_ORIGIN": "https://my.konf.app",
        "OVERRIDE_TENANTS": {
          "conference-settings": [
            "organization-cloud-native-days",
            "kkdemo.org",
          ],
        },
      },
      "ratelimits": [
        {
          "name": "API_LIMITER",
          "namespace_id": "1793",
          "simple": { "limit": 300, "period": 60 },
        },
        {
          "name": "API_MUTATION_LIMITER",
          "namespace_id": "1889",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "API_IP_LIMITER",
          "namespace_id": "1796",
          "simple": { "limit": 1200, "period": 60 },
        },
      ],
      "services": [
        { "binding": "DIRECTORY", "service": "konf-tenant-directory" },
        { "binding": "CONTENT", "service": "konf-content" },
        { "binding": "PROGRAM", "service": "konf-program" },
        { "binding": "SPONSORS", "service": "konf-sponsors" },
        { "binding": "CONFERENCE", "service": "konf-conference" },
        { "binding": "IDENTITY", "service": "konf-identity" },
        {
          "binding": "IDENTITY_GRAPH",
          "service": "konf-identity",
          "entrypoint": "Graph",
        },
        {
          "binding": "MEMBERSHIP",
          "service": "konf-identity",
          "entrypoint": "Membership",
        },
      ],
    },
  },
}
