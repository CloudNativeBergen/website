# Development tools - exclude from production builds

src/dev-tools/
*.dev.*

# Test files

__tests__/
*.test.*
*.spec.*

# Documentation

docs/
*.md
!README.md

# Cloudflare gateway Worker and platform services: not part of the Next app.
# A top-level api/ is otherwise deployed as Vercel Functions (#1960).
/api/
/services/
# Except the one shared reserved-slug list the site imports (#2129).
/packages/*
!/packages/tenancy/
/packages/tenancy/*
!/packages/tenancy/src/
/packages/tenancy/src/*
!/packages/tenancy/src/reserved.ts

# DO NOT ignore cache directories - we need Vercel to rebuild CSS
# Commenting out potential cache ignores to ensure fresh CSS builds
# .next/cache/
# node_modules/.cache/
