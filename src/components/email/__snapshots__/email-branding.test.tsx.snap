exports[`unthemed email output is byte-identical > SpeakerTicketEmailTemplate 1`] = `"<div style="font-family:Inter, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;max-width:600px;margin:0 auto;background-color:#ffffff;line-height:1.6;color:#334155"><table role="presentation" style="width:100%;border-collapse:collapse"><tbody><tr><td><h1 style="color:#1D4ED8;margin-bottom:24px;margin-top:0;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:28px;font-weight:700;line-height:1.2">🎟️ Your speaker ticket is ready</h1><p style="font-size:16px;line-height:1.6;margin-bottom:16px;margin-top:0;color:#334155">Dear Ada Lovelace,</p><p style="font-size:16px;line-height:1.6;margin-bottom:16px;margin-top:0;color:#334155">Thank you for confirming your participation in Cloud Native Days Bergen! As a speaker, your conference ticket is on us. Use the complimentary code below to register — it covers 100% of the ticket price.</p><div style="background-color:#E0F2FE;padding:20px;border-radius:12px;margin-bottom:24px;border:1px solid #CBD5E1"><h3 style="color:#1D4ED8;margin-top:0;margin-bottom:16px;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:18px;font-weight:600">Event Details:</h3><ul style="margin:0;padding-left:20px;color:#334155;font-size:15px;line-height:1.6"><li style="margin-bottom:8px"><strong>Event:</strong> Cloud Native Days Bergen</li><li style="margin-bottom:8px"><strong>Location:</strong> Bergen, Norway</li><li style="margin-bottom:8px"><strong>Date:</strong> October 28, 2026</li><li style="margin-bottom:0"><strong>Website:</strong> <a href="https://cloudnativebergen.dev" style="color:#1D4ED8;text-decoration:none;font-weight:500">https://cloudnativebergen.dev</a></li></ul></div><div style="background-color:#E0F2FE;padding:20px;border-radius:12px;margin-bottom:24px;border:1px solid #CBD5E1;border-left:4px solid #1D4ED8"><h4 style="color:#1D4ED8;margin-top:0;margin-bottom:12px;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:16px;font-weight:600">🎟️ Your Complimentary Speaker Ticket</h4><p style="margin:0;color:#334155;font-size:15px;line-height:1.6;font-weight:600">Discount code</p><div style="margin:4px 0 16px 0"><code style="background-color:#F1F5F9;padding:6px 10px;border-radius:6px;font-family:Monaco, &#x27;Cascadia Code&#x27;, &#x27;Roboto Mono&#x27;, Consolas, &#x27;Courier New&#x27;, monospace;font-size:16px;color:#0F172A;font-weight:600;letter-spacing:0.5px">SPEAKER-2026</code></div><p style="margin:0;color:#64748B;font-size:14px;line-height:1.6;font-weight:400">Enter this code at checkout to get your speaker ticket for free. It is valid for a single ticket.</p></div><div style="text-align:center;margin-bottom:32px"><a href="https://example.com/register" style="background-color:#1D4ED8;color:white;padding:16px 32px;text-decoration:none;border-radius:16px;font-weight:600;font-size:16px;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;display:inline-block;text-align:center;transition:background-color 0.2s ease;border:none;box-shadow:0 4px 12px rgba(29, 78, 216, 0.25);line-height:1.2">Register Your Ticket</a></div><p style="font-size:16px;color:#334155;line-height:1.6;margin-bottom:24px;margin-top:0">We look forward to seeing you on stage at Cloud Native Days Bergen!</p><p style="font-size:13px;color:#94A3B8;text-align:center;margin-top:16px;margin-bottom:0;line-height:1.5">You can reach the organizers anytime via <a href="https://cloudnativebergen.dev/cfp/messages" style="color:#64748B;text-decoration:underline">Messages</a> on the site.</p></td></tr></tbody></table></div>"`;

exports[`unthemed email output is byte-identical > SponsorMessageNotificationTemplate 1`] = `"<div style="font-family:Inter, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;max-width:600px;margin:0 auto;background-color:#ffffff;line-height:1.6;color:#334155"><table role="presentation" style="width:100%;border-collapse:collapse"><tbody><tr><td><h1 style="color:#1D4ED8;margin-bottom:24px;margin-top:0;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:28px;font-weight:700;line-height:1.2">New message from the Cloud Native Days Bergen organizers</h1><p style="font-size:16px;line-height:1.6;margin-bottom:16px;margin-top:0;color:#334155">Hi Wile E. Coyote,</p><p style="font-size:16px;line-height:1.6;margin-bottom:16px;margin-top:0;color:#334155"><strong>The Organizers</strong> sent your team a message about your sponsorship of Cloud Native Days Bergen.</p><div style="background-color:#F8FAFC;padding:20px;border-radius:12px;margin-bottom:24px;border:1px solid #E5E7EB"><h4 style="color:#1D4ED8;margin-top:0;margin-bottom:12px;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:16px;font-weight:600">Message</h4><p style="margin:0;color:#334155;font-size:15px;line-height:1.6;font-weight:400">A question about your logo.</p></div><p style="font-size:16px;line-height:1.6;margin-bottom:16px;margin-top:0;color:#334155">Open your sponsor portal to read the full thread and reply.</p><div style="text-align:center;margin-bottom:32px"><a href="https://example.com/sponsor/portal/abc#messages" style="background-color:#1D4ED8;color:white;padding:16px 32px;text-decoration:none;border-radius:16px;font-weight:600;font-size:16px;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;display:inline-block;text-align:center;transit