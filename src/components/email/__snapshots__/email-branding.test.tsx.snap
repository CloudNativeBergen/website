exports[`unthemed email output is byte-identical > ContractSigningTemplate 1`] = `"<div style="font-family:Inter, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;max-width:600px;margin:0 auto;background-color:#ffffff;line-height:1.6;color:#334155"><table role="presentation" style="width:100%;border-collapse:collapse"><tbody><tr><td><h1 style="color:#1D4ED8;margin-bottom:24px;margin-top:0;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:28px;font-weight:700;line-height:1.2">Sponsorship Agreement — Cloud Native Days Bergen</h1><p style="font-size:16px;line-height:1.6;margin-bottom:16px;margin-top:0;color:#334155">Dear Wile E. Coyote,</p><p style="font-size:16px;line-height:1.6;margin-bottom:24px;margin-top:0;color:#334155">Your sponsorship agreement for Cloud Native Days Bergen is ready for digital signing. Please review and sign the document at your earliest convenience.</p><div style="background-color:#F8FAFC;padding:20px;border-radius:12px;margin-bottom:24px;border:1px solid #E5E7EB"><h4 style="color:#1D4ED8;margin-top:0;margin-bottom:12px;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:16px;font-weight:600">Sponsorship Details</h4><p style="margin:0;color:#334155;font-size:15px;line-height:1.6;font-weight:400"><strong>Event:</strong> Cloud Native Days Bergen</p><p style="margin:0;color:#334155;font-size:15px;line-height:1.6;font-weight:400"><strong>Date:</strong> October 28, 2026</p><p style="margin:0;color:#334155;font-size:15px;line-height:1.6;font-weight:400"><strong>Location:</strong> Bergen, Norway</p><p style="margin:0;color:#334155;font-size:15px;line-height:1.6;font-weight:400"><strong>Organization:</strong> Acme Corp</p><p style="margin:0;color:#334155;font-size:15px;line-height:1.6;font-weight:400"><strong>Partnership Level:</strong> Gold</p><p style="margin:0;color:#334155;font-size:15px;line-height:1.6;font-weight:400"><strong>Total Fee:</strong> NOK 100 000</p><p style="margin:0;color:#64748B;font-size:14px;line-height:1.6;font-weight:400">Signer: Wile E. Coyote (wile@example.com)</p></div><div style="text-align:center;margin-bottom:32px"><a href="https://example.com/sign" style="background-color:#1D4ED8;color:white;padding:16px 32px;text-decoration:none;border-radius:16px;font-weight:600;font-size:16px;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;display:inline-block;text-align:center;transition:background-color 0.2s ease;border:none;box-shadow:0 4px 12px rgba(29, 78, 216, 0.25);line-height:1.2">Review &amp; Sign Agreement</a></div><p style="font-size:14px;line-height:1.6;margin-top:24px;color:#64748B">This is a secure link where you can review the full agreement and provide your digital signature. The link is unique to your email address.</p><hr style="border:none;border-top:1px solid #CBD5E1;margin:32px 0"/><div style="text-align:center;margin-bottom:16px"><p style="font-size:16px;color:#334155;margin-bottom:12px;margin-top:0;font-weight:600">Follow Cloud Native Days Bergen:</p><div><a href="https://twitter.com/cnbergen" style="color:#1D4ED8;text-decoration:none;font-size:0;margin-right:12px;display:inline-block;padding:4px" title="Twitter" aria-label="Twitter"><span style="display:inline-block;vertical-align:middle;width:20px;height:20px"><span class="sr-only">Twitter</span><svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4" fill="currentColor"><path d="M20.055 7.983c.011.174.011.347.011.523 0 5.338-3.92 11.494-11.09 11.494v-.003A10.755 10.755 0 0 1 3 18.186c.308.038.618.057.928.058a7.655 7.655 0 0 0 4.841-1.733c-1.668-.032-3.13-1.16-3.642-2.805a3.753 3.753 0 0 0 1.76-.07C5.07 13.256 3.76 11.6 3.76 9.676v-.05a3.77 3.77 0 0 0 1.77.505C3.816 8.945 3.288 6.583 4.322 4.737c1.98 2.524 4.9 4.058 8.034 4.22a4.137 4.137 0 0 1 1.128-3.86A3.807 3.807 0 0 1 19 5.274a7.657 7.657 0 0 0 2.475-.98c-.29.934-.9 1.729-1.713 2.233A7.54 7.54 0 0 0 22 5.89a8.084 8.084 0 0 1-1.945 2.093Z"></path></svg></span></a><a href="https://github.com/cnbergen" style="color:#1D4ED8;text-decoration:none;font-size:0;margin-right:12px;display:inline-block;padding:4px" title="GitHub" aria-label="GitHub"><span style="display:inline-block;vertical-align:middle;width:20px;height:20px"><span class="sr-only">GitHub</span><svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" class="h-4 w-4"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.475 2 2 6.588 2 12.253c0 4.537 2.862 8.369 6.838 9.727.5.09.687-.218.687-.487 0-.243-.013-1.05-.013-1.91C7 20.059 6.35 18.957 6.15 18.38c-.113-.295-.6-1.205-1.025-1.448-.35-.192-.85-.667-.013-.68.788-.012 1.35.744 1.538 1.051.9 1.551 2.338 1.116 2.912.846.088-.666.35-1.115.638-1.371-2.225-.256-4.55-1.14-4.55-5.062 0-1.115.387-2.038 1.025-2.756-.1-.256-.45-1.307.1-2.717 0 0 .837-.269 2.75 1.051.8-.23 1.65-.346 2.5-.346.85 0 1.7.115 2.5.346 1.912-1.333 2.75-1.05 2.75-1.05.55 1.409.2 2.46.1 2.716.637.718 1.025 1.628 1.025 2.756 0 3.934-2.337 4.806-4.562 5.062.362.32.675.936.675 1.897 0 1.371-.013 2.473-.013 2.82 0 .268.188.589.688.486a10.039 10.039 0 0 0 4.932-3.74A10.447 10.447 0 0 0 22 12.253C22 6.588 17.525 2 12 2Z"></path></svg></span></a></div></div><div style="background-color:#F9FAFB;padding:16px;border-radius:8px;text-align:center;margin-top:32px"><p style="font-size:14px;color:#64748B;margin:0;line-height:1.5">This email was sent by <strong style="color:#1D4ED8">Cloud Native Days Bergen</strong>.<br/>If you have any questions, please contact the organizers.</p></div></td></tr></tbody></table></div>"`;

