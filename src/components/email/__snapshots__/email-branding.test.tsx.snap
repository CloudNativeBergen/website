exports[`unthemed email output is byte-identical > ContractSignedTemplate 1`] = `"<div style="font-family:Inter, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;max-width:600px;margin:0 auto;background-color:#ffffff;line-height:1.6;color:#334155"><table role="presentation" style="width:100%;border-collapse:collapse"><tbody><tr><td><h1 style="color:#059669;margin-bottom:24px;margin-top:0;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:28px;font-weight:700;line-height:1.2">Welcome aboard Cloud Native Days Bergen!</h1><p style="font-size:16px;line-height:1.6;margin-bottom:16px;margin-top:0;color:#334155">Dear Wile E. Coyote,</p><p style="font-size:16px;line-height:1.6;margin-bottom:24px;margin-top:0;color:#334155">Thank you for signing the sponsorship agreement for Cloud Native Days Bergen! We are thrilled to have Acme Corp on board as a partner.</p><div style="background-color:#F0FDF4;padding:20px;border-radius:12px;margin-bottom:24px;border:1px solid #BBF7D0"><h4 style="color:#059669;margin-top:0;margin-bottom:12px;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:16px;font-weight:600">Sponsorship Details</h4><p style="margin:0;color:#334155;font-size:15px;line-height:1.6;font-weight:400"><strong>Event:</strong> Cloud Native Days Bergen</p><p style="margin:0;color:#334155;font-size:15px;line-height:1.6;font-weight:400"><strong>Date:</strong> October 28, 2026</p><p style="margin:0;color:#334155;font-size:15px;line-height:1.6;font-weight:400"><strong>Location:</strong> Bergen, Norway</p><p style="margin:0;color:#334155;font-size:15px;line-height:1.6;font-weight:400"><strong>Organization:</strong> Acme Corp</p><p style="margin:0;color:#334155;font-size:15px;line-height:1.6;font-weight:400"><strong>Partnership Level:</strong> Gold</p><p style="margin:0;color:#334155;font-size:15px;line-height:1.6;font-weight:400"><strong>Total Fee:</strong> NOK 100 000</p><p style="margin:0;color:#334155;font-size:15px;line-height:1.6;font-weight:400"><strong>Signed by:</strong> Wile E. Coyote</p></div><p style="font-size:16px;line-height:1.6;margin-bottom:16px;margin-top:0;color:#334155">A copy of the signed agreement is attached to this email for your records.</p><p style="font-size:16px;line-height:1.6;margin-bottom:24px;margin-top:0;color:#334155">We look forward to a great partnership and an amazing event together!</p><p style="font-size:14px;line-height:1.6;margin-top:24px;color:#64748B">If you have any questions, please don&#x27;t hesitate to reply to this email.</p><hr style="border:none;border-top:1px solid #CBD5E1;margin:32px 0"/><div style="text-align:center;margin-bottom:16px"><p style="font-size:16px;color:#334155;margin-bottom:12px;margin-top:0;font-weight:600">Follow Cloud Native Days Bergen:</p><div><a href="https://twitter.com/cnbergen" style="color:#1D4ED8;text-decoration:none;font-size:0;margin-right:12px;display:inline-block;padding:4px" title="Twitter" aria-label="Twitter"><span style="display:inline-block;vertical-align:middle;width:20px;height:20px"><span class="sr-only">Twitter</span><svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4" fill="currentColor"><path d="M20.055 7.983c.011.174.011.347.011.523 0 5.338-3.92 11.494-11.09 11.494v-.003A10.755 10.755 0 0 1 3 18.186c.308.038.618.057.928.058a7.655 7.655 0 0 0 4.841-1.733c-1.668-.032-3.13-1.16-3.642-2.805a3.753 3.753 0 0 0 1.76-.07C5.07 13.256 3.76 11.6 3.76 9.676v-.05a3.77 3.77 0 0 0 1.77.505C3.816 8.945 3.288 6.583 4.322 4.737c1.98 2.524 4.9 4.058 8.034 4.22a4.137 4.137 0 0 1 1.128-3.86A3.807 3.807 0 0 1 19 5.274a7.657 7.657 0 0 0 2.475-.98c-.29.934-.9 1.729-1.713 2.233A7.54 7.54 0 0 0 22 5.89a8.084 8.084 0 0 1-1.945 2.093Z"></path></svg></span></a><a href="https://github.com/cnbergen" style="color:#1D4ED8;text-decoration:none;font-size:0;margin-right:12