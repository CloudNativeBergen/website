// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`unthemed email output is byte-identical > BadgeEmailTemplate (raw HTML) 1`] = `
"<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your speaker badge for Cloud Native Days Bergen 2026</title>
</head>
<body style="background-color: #f6f9fc; font-family: -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Ubuntu,sans-serif; margin: 0; padding: 0;">
  <div style="background-color: #ffffff; margin: 0 auto 64px; padding: 20px 0 48px; max-width: 600px;">
    <h1 style="color: #1D4ED8; font-size: 32px; font-weight: bold; margin: 40px 0; padding: 0 48px;">
      🎉 Congratulations, Ada Lovelace!
    </h1>

    <p style="color: #032B45; font-size: 16px; line-height: 26px; padding: 0 48px;">
      Thank you for being a speaker at Cloud Native Days Bergen 2026. Your contribution to our community is invaluable!
    </p>

    <p style="color: #032B45; font-size: 16px; line-height: 26px; padding: 0 48px;">
      We&apos;ve created an OpenBadges digital credential for you. This verifiable badge can be shared on LinkedIn, Credly, and other platforms that support OpenBadges.
    </p>

    <div style="padding: 27px 48px;">
      <a href="https://example.com/badge.png" style="background-color: #06B6D4; border-radius: 5px; color: #fff; font-size: 16px; font-weight: bold; text-decoration: none; text-align: center; display: block; padding: 12px 20px;">
        Download Your Badge
      </a>
    </div>

    <p style="color: #666666; font-size: 14px; line-height: 22px; padding: 0 48px; margin-top: 24px;">
      <strong>What is OpenBadges?</strong><br>
      OpenBadges is an open standard for digital credentials. Your badge contains cryptographically signed data that verifies your achievement. You can add it to your professional profiles and showcase your expertise.
    </p>

    <p style="color: #666666; font-size: 14px; line-height: 22px; padding: 0 48px; margin-top: 24px;">
      <strong>How to use your badge:</strong><br>
      1. Download the SVG badge file<br>
      2. Upload it to LinkedIn, Credly, or your portfolio<br>
      3. The badge contains embedded verification data that platforms can validate
    </p>

    <p style="color: #8898aa; font-size: 12px; line-height: 16px; padding: 0 48px; margin-top: 32px;">
      Cloud Native Bergen<br>
      Building the cloud native community
    </p>
  </div>
</body>
</html>"
`;

exports[`unthemed email output is byte-identical > BaseEmailTemplate 1`] = `"<div style="font-family:Inter, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;max-width:600px;margin:0 auto;background-color:#ffffff;line-height:1.6;color:#334155"><table role="presentation" style="width:100%;border-collapse:collapse"><tbody><tr><td><h1 style="color:#334155;margin-bottom:24px;margin-top:0;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:28px;font-weight:700;line-height:1.2">Hello</h1><p style="font-size:16px;line-height:1.6;margin-bottom:16px;margin-top:0;color:#334155">Dear Ada Lovelace,</p><p>Body</p><div style="background-color:#E0F2FE;padding:20px;border-radius:12px;margin-bottom:24px;border:1px solid #CBD5E1"><h3 style="color:#1D4ED8;margin-top:0;margin-bottom:16px;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:18px;font-weight:600">Event Details:</h3><ul style="margin:0;padding-left:20px;color:#334155;font-size:15px;line-height:1.6"><li style="margin-bottom:8px"><strong>Event:</strong> Cloud Native Days Bergen</li><li style="margin-bottom:8px"><strong>Location:</strong> Bergen, Norway</li><li style="margin-bottom:8px"><strong>Date:</strong> October 28, 2026</li><li style="margin-bottom:0"><strong>Website:</strong> <a href="https://cloudnativebergen.dev" style="color:#1D4ED8;text-decoration:none;font-weight:500">https://cloudnativebergen.dev</a></li></ul></div><hr style="border:none;border-top:1px solid #CBD5E1;margin:32px 0"/><div style="text-align:center;margin-bottom:16px"><p style="font-size:16px;color:#334155;margin-bottom:12px;margin-top:0;font-weight:600">Follow Cloud Native Days Bergen:</p><div><a href="https://twitter.com/cnbergen" style="color:#1D4ED8;text-decoration:none;font-size:0;margin-right:12px;display:inline-block;padding:4px" title="Twi