exports[`unthemed email output is byte-identical > ProposalAcceptTemplate 1`] = `"<div style="font-family:Inter, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;max-width:600px;margin:0 auto;background-color:#ffffff;line-height:1.6;color:#334155"><table role="presentation" style="width:100%;border-collapse:collapse"><tbody><tr><td><h1 style="color:#1D4ED8;margin-bottom:24px;margin-top:0;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:28px;font-weight:700;line-height:1.2">🎉 Your proposal has been accepted!</h1><p style="font-size:16px;line-height:1.6;margin-bottom:16px;margin-top:0;color:#334155">Dear Ada Lovelace,</p><p style="font-size:16px;line-height:1.6;margin-bottom:16px;margin-top:0;color:#334155">Thank you for submitting your proposal <strong style="color:#1D4ED8">&quot;Analytical Engines at Scale&quot;</strong> for Cloud Native Days Bergen.</p><p style="font-size:16px;line-height:1.6;margin-bottom:16px;margin-top:0;color:#334155">Congratulations! We&#x27;re excited to inform you that your proposal has been accepted for Cloud Native Days Bergen.</p><div style="background-color:#E0F2FE;padding:20px;border-radius:12px;margin-bottom:24px;border:1px solid #CBD5E1"><h3 style="color:#1D4ED8;margin-top:0;margin-bottom:16px;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:18px;font-weight:600">Event Details:</h3><ul style="margin:0;padding-left:20px;color:#334155;font-size:15px;line-height:1.6"><li style="margin-bottom:8px"><strong>Event:</strong> Cloud Native Days Bergen</li><li style="margin-bottom:8px"><strong>Location:</strong> Bergen, Norway</li><li style="margin-bottom:8px"><strong>Date:</strong> October 28, 2026</li><li style="margin-bottom:0"><strong>Website:</strong> <a href="https://cloudnativebergen.dev" style="color:#1D4ED8;text-decoration:none;font-weight:500">https://cloudnativebergen.dev</a></li></ul></div><div style="background-color:#F0F9FF;padding:20px;border-radius:12px;margin-bottom:24px;border:1px solid #BFDBFE;border-left:4px solid #1D4ED8"><h4 style="color:#1D4ED8;margin-top:0;margin-bottom:12px;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:16px;font-weight:600">Message from the organizers:</h4><p style="margin:0;color:#334155;font-size:15px;line-height:1.6;font-weight:400;font-style:italic">We loved the abstract.</p></div><div style="background-color:#FEF3C7;padding:20px;border-radius:12px;margin-bottom:24px;border:1px solid #F59E0B;border-left:4px solid #D97706"><h4 style="color:#1F2937;margin-top:0;margin-bottom:12px;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:16px;font-weight:600">⚠️ Action Required</h4><p style="margin:0;color:#1F2937;font-size:15px;line-height:1.6;font-weight:600">Please confirm your participation by clicking the button below:</p></div><div style="text-align:center;margin-bottom:32px"><a href="https://example.com/confirm" style="background-color:#1D4ED8;color:white;padding:16px 32px;text-decoration:none;border-radius:16px;font-weight:600;font-size:16px;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;display:inline-block;text-align:center;transition:background-color 0.2s ease;border:none;box-shadow:0 4px 12px rgba(29, 78, 216, 0.25);line-height:1.2">Confirm Your Participation</a></div><p style="font-size:16px;color:#334155;line-height:1.6;margin-bottom:24px;margin-top:0">We look forward to your presentation at Cloud Native Days Bergen!</p><p style="font-size:13px;color:#94A3B8;text-align:center;margin-top:16px;margin-bottom:0;line-height:1.5">You can reach the organizers anytime via <a href="https://cloudnativebergen.dev/cfp/messages" style="color:#64748B;text-decoration:underline">Messages</a> on the site.</p></td></tr></tbody></table></div>"`;

exports[`unthemed email output is byte-identical > ProposalRejectTemplate 1`] = `"<div style="font-family:Inter, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;max-width:600px;margin:0 auto;background-color:#ffffff;line-height:1.6;color:#334155"><table role="presentation" style="width:100%;border-collapse:collapse"><tbody><tr><td><h1 style="color:#334155;margin-bottom:24px;margin-top:0;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:28px;font-weight:700;line-height:1.2">Thank you for your proposal submission</h1><p style="font-size:16px;line-height:1.6;margin-bottom:16px;margin-top:0;color:#334155">Dear Ada Lovelace,</p><p style="font-size:16px;line-height:1.6;margin-bottom:16px;margin-top:0;color:#334155">Thank you for submitting your proposal <strong style="color:#1D4ED8">&quot;Analytical Engines at Scale&quot;</strong> for Cloud Native Days Bergen.</p><p style="font-size:16px;line-height:1.6;margin-bottom:24px;margin-top:0;color:#334155">After careful consideration, we regret to inform you that we won&#x27;t be able to include your proposal in this year&#x27;s program. This decision was difficult to make given the high quality of submissions we received.</p><div style="background-color:#E0F2FE;padding:20px;border-radius:12px;margin-bottom:24px;border:1px solid #CBD5E1"><h3 style="color:#1D4ED8;margin-top:0;margin-bottom:16px;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:18px;font-weight:600">Event Details:</h3><ul style="margin:0;padding-left:20px;color:#334155;font-size:15px;line-height:1.6"><li style="margin-bottom:8px"><strong>Event:</strong> Cloud Native Days Bergen</li><li style="margin-bottom:8px"><strong>Location:</strong> Bergen, Norway</li><li style="margin-bottom:8px"><strong>Date:</strong> October 28, 2026</li><li style="margin-bottom:0"><strong>Website:</strong> <a href="https://cloudnativebergen.dev" style="color:#1D4ED8;text-decoration:none;font-weight:500">https://cloudnativebergen.dev</a></li></ul></div><div style="background-color:#FEF2F2;padding:20px;border-radius:12px;margin-bottom:24px;border:1px solid #FECACA;border-left:4px solid #EF4444"><h4 style="color:#DC2626;margin-top:0;margin-bottom:12px;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:16px;font-weight:600">Feedback from the organizers:</h4><p style="margin:0;color:#334155;font-size:15px;line-height:1.6;font-weight:400;font-style:italic">We loved the abstract.</p></div><div style="background:linear-gradient(135deg, #10B981, #059669);padding:20px;border-radius:12px;margin-bottom:24px;border:1px solid #10B981"><h4 style="color:white;margin-top:0;margin-bottom:12px;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:16px;font-weight:600">💡 Keep in touch!</h4><p style="margin:0;color:white;font-size:15px;line-height:1.6;font-weight:400">We encourage you to submit proposals for future events and stay connected with the Cloud Native Days Bergen community.</p></div><p style="font-size:16px;line-height:1.6;margin-bottom:16px;margin-top:0;color:#334155">We appreciate your interest in contributing to our community and hope to see you at future events.</p><p style="font-size:13px;color:#94A3B8;text-align:center;margin-top:16px;margin-bottom:0;line-height:1.5">You can reach the organizers anytime via <a href="https://cloudnativebergen.dev/cfp/messages" style="color:#64748B;text-decoration:underline">Messages</a> on the site.</p></td></tr></tbody></table></div>"`;

exports[`unthemed email output is byte-identical > ProposalWaitlistTemplate 1`] = `"<div style="font-family:Inter, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;max-width:600px;margin:0 auto;background-color:#ffffff;line-height:1.6;color:#334155"><table role="presentation" style="width:100%;border-collapse:collapse"><tbody><tr><td><h1 style="color:#F97316;margin-bottom:24px;margin-top:0;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:28px;font-weight:700;line-height:1.2">Your proposal has been waitlisted</h1><p style="font-size:16px;line-height:1.6;margin-bottom:16px;margin-top:0;color:#334155">Dear Ada Lovelace,</p><p style="font-size:16px;line-height:1.6;margin-bottom:16px;margin-top:0;color:#334155">Thank you for submitting your proposal <strong style="color:#1D4ED8">&quot;Analytical Engines at Scale&quot;</strong> for Cloud Native Days Bergen.</p><p style="font-size:16px;line-height:1.6;margin-bottom:16px;margin-top:0;color:#334155">Thank you for submitting your proposal to Cloud Native Days Bergen. After careful review, we&#x27;re pleased to inform you that your proposal has been added to our waitlist.</p><div style="background-color:#E0F2FE;padding:20px;border-radius:12px;margin-bottom:24px;border:1px solid #CBD5E1"><h3 style="color:#1D4ED8;margin-top:0;margin-bottom:16px;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:18px;font-weight:600">Event Details:</h3><ul style="margin:0;padding-left:20px;color:#334155;font-size:15px;line-height:1.6"><li style="margin-bottom:8px"><strong>Event:</strong> Cloud Native Days Bergen</li><li style="margin-bottom:8px"><strong>Location:</strong> Bergen, Norway</li><li style="margin-bottom:8px"><strong>Date:</strong> October 28, 2026</li><li style="margin-bottom:0"><strong>Website:</strong> <a href="https://cloudnativebergen.dev" style="color:#1D4ED8;text-decoration:none;font-weight:500">https://cloudnativebergen.dev</a></li></ul></div><div style="background-color:#FFF7ED;padding:20px;border-radius:12px;margin-bottom:24px;border:1px solid #FDBA74;border-left:4px solid #F97316"><h4 style="color:#1D4ED8;margin-top:0;margin-bottom:12px;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:16px;font-weight:600">Message from the organizers:</h4><p style="margin:0;color:#334155;font-size:15px;line-height:1.6;font-weight:400;font-style:italic">We loved the abstract.</p></div><div style="background-color:#FEF3C7;padding:20px;border-radius:12px;margin-bottom:24px;border:1px solid #F59E0B;border-left:4px solid #D97706"><h4 style="color:#1F2937;margin-top:0;margin-bottom:12px;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:16px;font-weight:600">ℹ️ What does this mean?</h4><p style="margin:0;color:#1F2937;font-size:15px;line-height:1.6;font-weight:400">While we couldn&#x27;t include your talk in the initial program, your proposal is on our waitlist. If a speaking slot becomes available, we&#x27;ll reach out to you as soon as possible.</p></div><p style="font-size:16px;line-height:1.6;margin-bottom:16px;margin-top:0;color:#334155">We appreciate your interest in Cloud Native Days Bergen and hope to have the opportunity to include your talk in the program. We&#x27;ll keep you updated if anything changes.</p><p style="font-size:13px;color:#94A3B8;text-align:center;margin-top:16px;margin-bottom:0;line-height:1.5">You can reach the organizers anytime via <a href="https://cloudnativebergen.dev/cfp/messages" style="color:#64748B;text-decoration:underline">Messages</a> on the site.</p></td></tr></tbody></table></div>"`;

