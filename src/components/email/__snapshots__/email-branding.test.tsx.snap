exports[`unthemed email output is byte-identical > MessageNotificationTemplate 1`] = `"<div style="font-family:Inter, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;max-width:600px;margin:0 auto;background-color:#ffffff;line-height:1.6;color:#334155"><table role="presentation" style="width:100%;border-collapse:collapse"><tbody><tr><td><h1 style="color:#334155;margin-bottom:24px;margin-top:0;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:28px;font-weight:700;line-height:1.2">New message</h1><div style="margin-bottom:24px"><p style="margin:0;color:#334155;font-size:15px;line-height:1.6;font-weight:400"><strong>The Organizers</strong> sent you a new message about <strong>&quot;About your talk&quot;</strong>.</p></div><div style="background-color:#F8FAFC;padding:20px;border-radius:12px;margin-bottom:24px;border:1px solid #E5E7EB"><h4 style="color:#1D4ED8;margin-top:0;margin-bottom:12px;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-size:16px;font-weight:600">Message</h4><p style="margin:0;color:#475569;font-size:14px;line-height:1.6;font-weight:400">We have a question about your session.</p></div><div style="text-align:center;margin-top:24px;margin-bottom:24px"><div style="text-align:center;margin-bottom:32px"><a href="https://example.com/cfp/messages" style="background-color:#1D4ED8;color:white;padding:16px 32px;text-decoration:none;border-radius:16px;font-weight:600;font-size:16px;font-family:&quot;Space Grotesk&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;display:inline-block;text-align:center;transition:background-color 0.2s ease;border:none;box-shadow:0 4px 12px rgba(29, 78, 216, 0.25);line-height:1.2">Reply in app</a></div></div><p style="margin:0;color:#64748B;font-size:14px;line-height:1.6;font-weight:400">Replying to this email reaches the organizers&#x27; shared inbox — for the full conversation, reply in the app.</p><p style="margin:0;color:#64748B;font-size:14px;line-height:1.6;font-weight:400">The link below opens the global message-email setting on your profile. <a href="https://example.com/cfp/profile" style="color:#2563EB;text-decoration:underline">Manage notification preferences</a></p><hr style="border:none;border-top:1px solid #CBD5E1;margin:32px 0"/><div style="text-align:center;margin-bottom:16px"><p style="font-size:16px;color:#334155;margin-bottom:12px;margin-top:0;font-weight:600">Follow Cloud Native Days Bergen:</p><div><a href="https://twitter.com/cnbergen" style="color:#1D4ED8;text-decoration:none;font-size:0;margin-right:12px;display:inline-block;padding:4px" title="Twitter" aria-label="Twitter"><span style="display:inline-block;vertical-align:middle;width:20px;height:20px"><span class="sr-only">Twitter</span><svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4" fill="currentColor"><path d="M20.055 7.983c.011.174.011.347.011.523 0 5.338-3.92 11.494-11.09 11.494v-.003A10.755 10.755 0 0 1 3 18.186c.308.038.618.057.928.058a7.655 7.655 0 0 0 4.841-1.733c-1.668-.032-3.13-1.16-3.642-2.805a3.753 3.753 0 0 0 1.76-.07C5.07 13.256 3.76 11.6 3.76 9.676v-.05a3.77 3.77 0 0 0 1.77.505C3.816 8.945 3.288 6.583 4.322 4.737c1.98 2.524 4.9 4.058 8.034 4.22a4.137 4.137 0 0 1 1.128-3.86A3.807 3.807 0 0 1 19 5.274a7.657 7.657 0 0 0 2.475-.98c-.29.934-.9 1.729-1.713 2.233A7.54 7.54 0 0 0 22 5.89a8.084 8.084 0 0 1-1.945 2.093Z"></path></svg></span></a><a href="https://github.com/cnbergen" style="color:#1D4ED8;text-decoration:none;font-size:0;margin-right:12px;display:inline-block;padding:4px" title="GitHub" aria-label="GitHub"><span style="display:inline-block;vertical-align:middle;width:20px;height:20px"><span class="sr-only">GitHub</span><svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" class="h-4 w-4"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C