exports[`ImageGallery — default (carousel) markup is frozen > renders tenant copy overrides 1`] = `"<section class="py-16 sm:py-24"><div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"><div class="mx-auto max-w-2xl text-center"><h2 class="font-space-grotesk text-3xl font-bold tracking-tight text-brand-slate-gray sm:text-4xl dark:text-white">Photos from last year</h2><p class="mt-4 text-lg text-brand-slate-gray/80 dark:text-gray-300">A look back at the 2025 edition.</p></div><div class="mt-12"><div class="relative w-full mx-auto" tabindex="0"><div class="relative aspect-[16/9] w-full overflow-hidden rounded-lg bg-gray-100 dark:bg-gray-800"><div class="relative h-full w-full"><div class="absolute inset-0 flex items-center justify-center"><div class="h-12 w-12 animate-spin rounded-full border-4 border-gray-300 border-t-brand-cloud-blue"></div></div><img alt="Keynote on the main stage" class="h-full w-full object-cover" loading="eager" srcset="https://cdn.sanity.io/images/mock/image.png 1x, https://cdn.sanity.io/images/mock/image.png 2x" src="https://cdn.sanity.io/images/mock/image.png"></div><button class="inline-flex items-center justify-center font-semibold transition-all duration-200 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed rounded-full bg-white/90 hover:bg-white text-gray-800 shadow-lg backdrop-blur-sm focus-visible:outline-brand-cloud-blue p-2 absolute top-1/2 left-4 -translate-y-1/2" aria-label="Previous image"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"></path></svg></button><button class="inline-flex items-center justify-center font-semibold transition-all duration-200 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed rounded-full bg-white/90 hover:bg-white text-gray-800 shadow-lg backdrop-blur-sm focus-visible:outline-brand-cloud-blue p-2 absolute top-1/2 right-4 -translate-y-1/2" aria-label="Next image"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"></path></svg></button><div class="absolute bottom-4 left-1/2 flex -translate-x-1/2 space-x-2"><button class="h-2 rounded-full transition-all w-8 bg-white" aria-label="Go to image 1" aria-current="true"></button><button class="h-2 w-2 rounded-full transition-all bg-white/50 hover:bg-white/75" aria-label="Go to image 2" aria-current="false"></button><button class="h-2 w-2 rounded-full transition-all bg-white/50 hover:bg-white/75" aria-label="Go to image 3" aria-current="false"></button></div></div><div class="mt-4 text-center"><h3 class="font-space-grotesk text-lg font-semibold text-brand-slate-gray dark:text-white">Grieghallen, Bergen</h3><p class="mt-1 text-sm text-brand-slate-gray/70 dark:text-gray-400">Photo by Olav Nordmann</p></div><div class="sr-only" aria-live="polite" aria-atomic="true">Image 1 of 3</div></div></div></div></section>"`;

