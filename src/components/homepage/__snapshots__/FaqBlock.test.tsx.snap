exports[`FaqBlock — default (accordion) markup is frozen > renders the conference ticket FAQs when the source says so 1`] = `"<section class="py-20 sm:py-32"><div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"><h2 class="font-space-grotesk mb-10 text-center text-4xl font-medium tracking-tighter text-brand-cloud-blue sm:text-5xl dark:text-blue-400">Frequently asked questions</h2><div class="mx-auto max-w-3xl space-y-3"><details class="group rounded-xl bg-white/80 shadow-md ring-1 ring-brand-cloud-blue/10 backdrop-blur-sm dark:bg-gray-800/80 dark:ring-gray-700"><summary class="flex min-h-[44px] cursor-pointer items-center justify-between px-5 py-4"><span class="font-space-grotesk pr-4 text-sm font-semibold text-brand-slate-gray dark:text-gray-200">Can I get a refund?</span><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-4 w-4 shrink-0 text-brand-cloud-blue transition-transform group-open:rotate-180 dark:text-blue-400"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"></path></svg></summary><div class="border-t border-gray-100 px-5 py-4 dark:border-gray-700"><p class="font-inter text-sm leading-relaxed whitespace-pre-line text-brand-slate-gray/80 dark:text-gray-300">Tickets are refundable up to 14 days before the event.</p></div></details></div></div></section>"`;

