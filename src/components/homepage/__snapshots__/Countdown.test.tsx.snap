exports[`Countdown — default (units) markup is frozen > renders the four big unit tiles under a heading 1`] = `"<section class="py-20 sm:py-32"><div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"><h2 class="font-space-grotesk mb-10 text-center text-4xl font-medium tracking-tighter text-brand-cloud-blue sm:text-5xl dark:text-blue-400">Cloud Native Days Bergen starts in</h2><div class="mx-auto grid max-w-2xl grid-cols-4 gap-4 sm:gap-8" role="timer" aria-live="off"><div class="flex min-w-0 flex-col items-center"><span class="font-space-grotesk text-4xl font-bold text-brand-slate-gray tabular-nums sm:text-6xl dark:text-gray-100" aria-hidden="false">90</span><span class="font-inter mt-1 text-xs font-medium tracking-wide text-brand-slate-gray/60 uppercase sm:text-sm dark:text-gray-400">Days</span></div><div class="flex min-w-0 flex-col items-center"><span class="font-space-grotesk text-4xl font-bold text-brand-slate-gray tabular-nums sm:text-6xl dark:text-gray-100" aria-hidden="false">05</span><span class="font-inter mt-1 text-xs font-medium tracking-wide text-brand-slate-gray/60 uppercase sm:text-sm dark:text-gray-400">Hours</span></div><div class="flex min-w-0 flex-col items-center"><span class="font-space-grotesk text-4xl font-bold text-brand-slate-gray tabular-nums sm:text-6xl dark:text-gray-100" aria-hidden="false">00</span><span class="font-inter mt-1 text-xs font-medium tracking-wide text-brand-slate-gray/60 uppercase sm:text-sm dark:text-gray-400">Minutes</span></div><div class="flex min-w-0 flex-col items-center"><span class="font-space-grotesk text-4xl font-bold text-brand-slate-gray tabular-nums sm:text-6xl dark:text-gray-100" aria-hidden="false">00</span><span class="font-inter mt-1 text-xs font-medium tracking-wide text-brand-slate-gray/60 uppercase sm:text-sm dark:text-gray-400">Seconds</span></div></div></div></section>"`;

exports[`Countdown — default (units) markup is frozen > renders the live message once the target has passed 1`] = `"<section class="py-20 sm:py-32"><div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"><p class="font-space-grotesk mb-10 text-center text-4xl font-medium tracking-tighter text-brand-cloud-blue sm:text-5xl dark:text-blue-400">We are live — welcome to Bergen!</p></div></section>"`;

