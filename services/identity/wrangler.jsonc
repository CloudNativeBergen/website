{
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "konf-identity",
      "database_id": "TO_BE_CREATED",
      "migrations_dir": "migrations",
    },
  ],
  "name": "konf-identity",
  "account_id": "eefa2cb5c8528a07d7bf8b00a6606dcd",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "services": [
    {
      "binding": "DIRECTORY",
      "service": "konf-tenant-directory",
    },
  ],
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "preview": {
      // Last moment a NextAuth session may upgrade to an identity session (#1842).
      "vars": { "IDENTITY_UPGRADE_UNTIL": "2026-12-03T00:00:00Z" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "konf-identity-preview",
          "database_id": "2192470e-1f18-40cc-813f-c18883237c78",
          "migrations_dir": "migrations",
        },
      ],
      "name": "konf-identity-preview",
      "ratelimits": [
        {
          "name": "HANDOFF_SITE_LIMIT",
          "namespace_id": "1803",
          "simple": {
            "limit": 60,
            "period": 60,
          },
        },
        {
          "name": "HANDOFF_IP_LIMIT",
          "namespace_id": "1804",
          "simple": {
            "limit": 20,
            "period": 60,
          },
        },
      ],
      "routes": [
        {
          "pattern": "id-preview.konf.app",
          "custom_domain": true,
        },
      ],
      "services": [
        {
          "binding": "DIRECTORY",
          "service": "konf-tenant-directory-preview",
        },
      ],
    },
    "production": {
      "vars": { "IDENTITY_UPGRADE_UNTIL": "2026-12-03T00:00:00Z" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "konf-identity",
          "database_id": "20c89ee4-f729-483b-8a0f-8fba00d4f411",
          "migrations_dir": "migrations",
        },
      ],
      "name": "konf-identity",
      "ratelimits": [
        {
          "name": "HANDOFF_SITE_LIMIT",
          "namespace_id": "1813",
          "simple": {
            "limit": 60,
            "period": 60,
          },
        },
        {
          "name": "HANDOFF_IP_LIMIT",
          "namespace_id": "1814",
          "simple": {
            "limit": 20,
            "period": 60,
          },
        },
      ],
      "routes": [
        {
          "pattern": "id.konf.app",
          "custom_domain": true,
        },
      ],
      "services": [
        {
          "binding": "DIRECTORY",
          "service": "konf-tenant-directory",
        },
      ],
    },
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "destinations": ["grafana-cloud-traces"],
    },
    "logs": {
      "enabled": true,
      "destinations": ["grafana-cloud-logs"],
    },
  },
}
