{
  "name": "konf-identity",
  "account_id": "eefa2cb5c8528a07d7bf8b00a6606dcd",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "konf-identity",
      "database_id": "TO_BE_CREATED",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "preview": {
      "name": "konf-identity-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "konf-identity-preview",
          "database_id": "2192470e-1f18-40cc-813f-c18883237c78",
          "migrations_dir": "migrations",
        },
      ],
    },
    "production": {
      "name": "konf-identity",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "konf-identity",
          "database_id": "20c89ee4-f729-483b-8a0f-8fba00d4f411",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "destinations": ["grafana-cloud-traces"],
    },
    "logs": {
      "enabled": true,
      "destinations": ["grafana-cloud-logs"],
    },
  },
}
