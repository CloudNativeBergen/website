{
  "name": "konf-content",
  "account_id": "bf423d08017f82ace4019bc367338981",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SANITY_PROJECT_ID": "mvzwvw14",
    "SANITY_DATASET": "development",
  },
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "preview": {
      "name": "konf-content-preview",
      "vars": {
        "SANITY_PROJECT_ID": "mvzwvw14",
        "SANITY_DATASET": "development",
      },
    },
    "production": {
      "name": "konf-content",
      "vars": {
        "SANITY_PROJECT_ID": "mvzwvw14",
        "SANITY_DATASET": "production",
      },
    },
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "destinations": ["grafana-cloud-traces"],
    },
    "logs": {
      "enabled": true,
      "destinations": ["grafana-cloud-logs"],
    },
  },
}
