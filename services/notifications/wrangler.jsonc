{
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "konf-notifications",
      "database_id": "TO_BE_CREATED",
      "migrations_dir": "migrations",
    },
  ],
  "name": "konf-notifications",
  "account_id": "eefa2cb5c8528a07d7bf8b00a6606dcd",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "services": [
    {
      "binding": "CONFERENCE",
      "service": "konf-conference",
      "entrypoint": "ProgramDate",
    },
  ],
  "vars": {
    "SANITY_PROJECT_ID": "mvzwvw14",
    "SANITY_DATASET": "development",
  },
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "konf-notifications-preview",
          "database_id": "7a5e4989-9b71-4e1b-9143-c10a97cbd9be",
          "migrations_dir": "migrations",
        },
      ],
      "name": "konf-notifications-preview",
      "services": [
        {
          "binding": "CONFERENCE",
          "entrypoint": "ProgramDate",
          "service": "konf-conference-preview",
        },
      ],
      "vars": {
        "SANITY_PROJECT_ID": "mvzwvw14",
        "SANITY_DATASET": "development",
      },
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "konf-notifications",
          "database_id": "e3b444c7-2111-43a3-a003-f2fe237e5ca1",
          "migrations_dir": "migrations",
        },
      ],
      "name": "konf-notifications",
      "services": [
        {
          "binding": "CONFERENCE",
          "service": "konf-conference",
          "entrypoint": "ProgramDate",
        },
      ],
      "vars": {
        "SANITY_PROJECT_ID": "mvzwvw14",
        "SANITY_DATASET": "production",
      },
    },
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "destinations": ["grafana-cloud-traces"],
    },
    "logs": {
      "enabled": true,
      "destinations": ["grafana-cloud-logs"],
    },
  },
}
