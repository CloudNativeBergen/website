{
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "konf-conference",
      "database_id": "TO_BE_CREATED",
      "migrations_dir": "migrations",
    },
  ],
  "name": "konf-conference",
  "account_id": "eefa2cb5c8528a07d7bf8b00a6606dcd",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["17 4 * * *"],
  },
  "vars": {
    "SANITY_PROJECT_ID": "mvzwvw14",
    "SANITY_DATASET": "development",
  },
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "konf-conference-preview",
          "database_id": "f6e9d558-db2e-4200-8afc-c1f95655bf5e",
          "migrations_dir": "migrations",
        },
      ],
      "name": "konf-conference-preview",
      "vars": {
        "SANITY_PROJECT_ID": "mvzwvw14",
        "SANITY_DATASET": "development",
      },
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "konf-conference",
          "database_id": "245b474a-5dfe-410f-98fa-97cc13813869",
          "migrations_dir": "migrations",
        },
      ],
      "name": "konf-conference",
      "vars": {
        "SANITY_PROJECT_ID": "mvzwvw14",
        "SANITY_DATASET": "production",
        "PUSH_WEBHOOK_URL": "https://my.konf.app/api/push/events",
      },
    },
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "destinations": ["grafana-cloud-traces"],
    },
    "logs": {
      "enabled": true,
      "destinations": ["grafana-cloud-logs"],
    },
  },
}
