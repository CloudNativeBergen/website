{
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "konf-tenant-directory",
      "database_id": "TO_BE_CREATED",
      "migrations_dir": "migrations",
    },
  ],
  "name": "konf-tenant-directory",
  "account_id": "eefa2cb5c8528a07d7bf8b00a6606dcd",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "services": [
    {
      "binding": "IDENTITY",
      "service": "konf-identity",
      "entrypoint": "Organizations",
    },
    {
      "binding": "CONFERENCE",
      "service": "konf-conference",
      "entrypoint": "ProgramDate",
    },
    {
      "binding": "EDITIONS",
      "service": "konf-conference",
      "entrypoint": "Editions",
    },
  ],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "vars": {
    "SANITY_PROJECT_ID": "mvzwvw14",
    "SANITY_DATASET": "development",
    "DOMAIN_CNAME_TARGET": "e5846d5fd11bb9bc.vercel-dns-017.com",
    "DOMAIN_APEX_A": "216.150.1.1,216.150.16.1",
  },
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "konf-tenant-directory-preview",
          "database_id": "82b1dd25-4dcd-4b18-b712-86eb02b5c0df",
          "migrations_dir": "migrations",
        },
      ],
      "name": "konf-tenant-directory-preview",
      "ratelimits": [
        {
          "name": "SIGNUP_LIMIT",
          "namespace_id": "2163",
          "simple": {
            "limit": 5,
            "period": 60,
          },
        },
        {
          "name": "INVITE_LIMIT",
          "namespace_id": "2161",
          "simple": {
            "limit": 5,
            "period": 60,
          },
        },
      ],
      "services": [
        {
          "binding": "IDENTITY",
          "entrypoint": "Organizations",
          "service": "konf-identity-preview",
        },
        {
          "binding": "CONFERENCE",
          "entrypoint": "ProgramDate",
          "service": "konf-conference-preview",
        },
        {
          "binding": "EDITIONS",
          "entrypoint": "Editions",
          "service": "konf-conference-preview",
        },
      ],
      "vars": {
        "SANITY_PROJECT_ID": "mvzwvw14",
        "SANITY_DATASET": "development",
        "DOMAIN_CNAME_TARGET": "e5846d5fd11bb9bc.vercel-dns-017.com",
        "DOMAIN_APEX_A": "216.150.1.1,216.150.16.1",
      },
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "konf-tenant-directory",
          "database_id": "73355a8e-33d8-4bf3-8115-013768c6520c",
          "migrations_dir": "migrations",
        },
      ],
      "name": "konf-tenant-directory",
      "ratelimits": [
        {
          "name": "SIGNUP_LIMIT",
          "namespace_id": "2173",
          "simple": {
            "limit": 5,
            "period": 60,
          },
        },
        {
          "name": "INVITE_LIMIT",
          "namespace_id": "2171",
          "simple": {
            "limit": 5,
            "period": 60,
          },
        },
      ],
      "services": [
        {
          "binding": "IDENTITY",
          "service": "konf-identity",
          "entrypoint": "Organizations",
        },
        {
          "binding": "CONFERENCE",
          "service": "konf-conference",
          "entrypoint": "ProgramDate",
        },
        {
          "binding": "EDITIONS",
          "service": "konf-conference",
          "entrypoint": "Editions",
        },
      ],
      "vars": {
        "SANITY_PROJECT_ID": "mvzwvw14",
        "SANITY_DATASET": "production",
        "SITE_URL": "https://auth.konf.app",
        "DOMAIN_CNAME_TARGET": "e5846d5fd11bb9bc.vercel-dns-017.com",
        "DOMAIN_APEX_A": "216.150.1.1,216.150.16.1",
      },
    },
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "destinations": ["grafana-cloud-traces"],
    },
    "logs": {
      "enabled": true,
      "destinations": ["grafana-cloud-logs"],
    },
  },
}
