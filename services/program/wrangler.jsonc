{
  "name": "konf-program",
  "account_id": "eefa2cb5c8528a07d7bf8b00a6606dcd",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SANITY_PROJECT_ID": "mvzwvw14",
    "SANITY_DATASET": "development",
  },
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "preview": {
      "name": "konf-program-preview",
      "vars": {
        "SANITY_PROJECT_ID": "mvzwvw14",
        "SANITY_DATASET": "development",
      },
    },
    "production": {
      "name": "konf-program",
      "vars": {
        "SANITY_PROJECT_ID": "mvzwvw14",
        "SANITY_DATASET": "production",
      },
    },
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "destinations": ["grafana-cloud-traces"],
    },
    "logs": {
      "enabled": true,
      "destinations": ["grafana-cloud-logs"],
    },
  },
}
